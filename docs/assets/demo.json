{
  "title": "a copy of crates/scrutate/src",
  "repo": "a copy of this repository's crates/scrutate/src, indexed with scrutate index",
  "setup": [
    [
      "scrutate",
      "index"
    ]
  ],
  "commands": [
    {
      "argv": [
        "scrutate",
        "grep",
        "--index",
        "max_filesize"
      ],
      "keep": 4,
      "highlight": "max_filesize",
      "output": [
        "src/config.rs:15://! max_filesize = \"10M\"     # SCRUTATE_GREP_MAX_FILESIZE",
        "src/config.rs:47:    pub max_filesize: Option<String>,",
        "src/config.rs:119:    if let Some(v) = &cfg.grep.max_filesize {",
        "src/cli.rs:216:    pub max_filesize: Option<String>,",
        "src/cli.rs:341:        max_filesize: None,",
        "src/cli.rs:1026:            max_filesize,",
        "src/cli.rs:1097:                max_filesize: max_filesize.as_deref().map(parse_size).transpose()?,",
        "src/instant.rs:70:    pub max_filesize: Option<u64>,",
        "src/instant.rs:142:            max_filesize: None,",
        "src/instant.rs:978:        if self.hidden || self.no_ignore || self.follow_links || self.max_depth.is_some() || self.max_filesize.is_some() {",
        "src/instant.rs:1919:        .max_filesize(o.max_filesize)"
      ]
    },
    {
      "argv": [
        "scrutate",
        "search",
        "parse a size like 10M"
      ],
      "keep": 5,
      "only": "^\\S",
      "output": [
        "src/cli.rs:640-649  [function] parse_size",
        "    fn parse_size(s: &str) -> Result<u64> {",
        "        let s = s.trim();",
        "        let (num, mult) = match s.chars().last() {",
        "            Some('K') | Some('k') => (&s[..s.len() - 1], 1024u64),",
        "            Some('M') | Some('m') => (&s[..s.len() - 1], 1024 * 1024),",
        "            Some('G') | Some('g') => (&s[..s.len() - 1], 1024 * 1024 * 1024),",
        "            _ => (s, 1),",
        "        };",
        "src/cli.rs:2315-2321  [function] tests.sizes_that_overflow_are_refused",
        "    #[test]",
        "        fn sizes_that_overflow_are_refused() {",
        "            assert_eq!(super::parse_size(\"10M\").unwrap(), 10 << 20);",
        "            assert_eq!(super::parse_size(\"17179869183G\").unwrap(), 17179869183 << 30);",
        "            assert!(super::parse_size(\"17179869184G\").is_err());",
        "            assert!(super::parse_size(\"x\").is_err());",
        "        }",
        "src/parse.rs:66-71  [struct] Parsed",
        "    #[derive(Debug, Default)]",
        "    pub struct Parsed {",
        "        pub chunks: Vec<Chunk>,",
        "        /// (1-based line, imported module as written, normalised)",
        "        pub imports: Vec<(i64, String)>,",
        "    }",
        "src/parse.rs:2298-2302  [function] parse_file",
        "    pub fn parse_file(path: &str, source: &str) -> Parsed {",
        "        let mut parsed = parse_file_with(path, source, None).0;",
        "        parsed.chunks.iter_mut().for_each(|c| c.fill(source.as_bytes()));",
        "        parsed",
        "    }",
        "src/parse.rs:2449-2453  [function] tests.cleandoc_like_python",
        "    #[test]",
        "        fn cleandoc_like_python() {",
        "            assert_eq!(cleandoc(\"\\n    Hello\\n      world\\n    \"), \"Hello\\n  world\");",
        "            assert_eq!(cleandoc(\"  First line\\n\\n    indented\"), \"First line\\n\\nindented\");",
        "        }",
        "src/parse.rs:2321-2323  [function] parse_source",
        "    pub fn parse_source(path: &str, source: &str) -> Vec<Chunk> {",
        "        parse_file(path, source).chunks",
        "    }",
        "src/parse.rs:2306-2319  [function] parse_file_with",
        "    pub fn parse_file_with(path: &str, source: &str, prev: Option<PrevParse>) -> (Parsed, Option<PrevParse>) {",
        "        if let Some(spec) = spec_for(path, source) {",
        "            if let Some(((chunks, mdoc, imports, loose), tree)) = grammar_chunks(spec, path, source, prev) {",
        "                // a parsed file is the grammar's verdict even when it holds no definitions: the",
        "                // keyword heuristics would invent symbols from prose (\"namespace so the ...\")",
        "                return (Parsed { chunks: finish(path, source, chunks, mdoc, loose), imports }, tree);",
        "            }",
        "        }",
        "src/parse.rs:1628-1630  [function] PrevParse.source_len",
        "    pub fn source_len(&self) -> usize {",
        "            self.source.len()",
        "        }"
