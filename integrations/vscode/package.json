{
  "name": "scrutate",
  "displayName": "Scrutate",
  "description": "Code intelligence from Scrutate: go to definition, references and symbols through the scrutate language server, plus ranked search, grep and callers.",
  "version": "0.1.0",
  "publisher": "scrutate",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/crisnahine/scrutate" },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "check": "tsc -p .",
    "test": "node test/root.test.js && node test/run.js"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "3.1.0",
    "typescript": "5.9.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "scrutate.search",
        "title": "Scrutate: Search (ranked, by meaning or name)"
      },
      {
        "command": "scrutate.grep",
        "title": "Scrutate: Grep (instant, no index)"
      },
      {
        "command": "scrutate.symbol",
        "title": "Scrutate: Go to symbol definition"
      },
      {
        "command": "scrutate.callers",
        "title": "Scrutate: Who calls this?"
      },
      {
        "command": "scrutate.refs",
        "title": "Scrutate: References of the word under the cursor"
      },
      {
        "command": "scrutate.index",
        "title": "Scrutate: Update index"
      }
    ],
    "configuration": {
      "title": "Scrutate",
      "properties": {
        "scrutate.path": {
          "type": "string",
          "default": "scrutate",
          "scope": "machine",
          "description": "Path to the scrutate binary. A machine setting: a workspace cannot change which program runs. On Windows a bare name is looked up on PATH, never in the opened folder."
        },
        "scrutate.results": {
          "type": "number",
          "default": 15,
          "description": "Number of ranked results to show."
        }
      }
    }
  }
}
