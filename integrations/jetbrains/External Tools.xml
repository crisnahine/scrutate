<toolSet name="Scrutate">
  <tool name="Scrutate: search" showInMainMenu="true" showInEditor="true" showInProject="true" showInSearchPopup="true" disabled="false" useConsole="true" showConsoleOnStdOut="true" showConsoleOnStdErr="true" synchronizeAfterRun="false">
    <exec>
      <option name="COMMAND" value="scrutate" />
      <option name="PARAMETERS" value="search -k 15 -- &quot;$Prompt$&quot;" />
      <option name="WORKING_DIRECTORY" value="$ProjectFileDir$" />
    </exec>
    <filter>
      <option name="NAME" value="file:line" />
      <option name="DESCRIPTION" value="path:line-line" />
      <option name="REGEXP" value="$FILE_PATH$:$LINE$" />
    </filter>
  </tool>
  <tool name="Scrutate: grep" showInMainMenu="true" showInEditor="true" showInProject="true" showInSearchPopup="true" disabled="false" useConsole="true" showConsoleOnStdOut="true" showConsoleOnStdErr="true" synchronizeAfterRun="false">
    <exec>
      <option name="COMMAND" value="scrutate" />
      <option name="PARAMETERS" value="grep --sort -- &quot;$Prompt$&quot; &quot;$ProjectFileDir$&quot;" />
      <option name="WORKING_DIRECTORY" value="$ProjectFileDir$" />
    </exec>
    <filter>
      <option name="NAME" value="file:line" />
      <option name="DESCRIPTION" value="path:line:text" />
      <option name="REGEXP" value="$FILE_PATH$:$LINE$:" />
    </filter>
  </tool>
  <tool name="Scrutate: symbol" showInMainMenu="true" showInEditor="true" showInProject="true" showInSearchPopup="true" disabled="false" useConsole="true" showConsoleOnStdOut="true" showConsoleOnStdErr="true" synchronizeAfterRun="false">
    <exec>
      <option name="COMMAND" value="scrutate" />
      <option name="PARAMETERS" value="symbol -- &quot;$SelectedText$&quot;" />
      <option name="WORKING_DIRECTORY" value="$ProjectFileDir$" />
    </exec>
    <filter>
      <option name="NAME" value="file:line" />
      <option name="DESCRIPTION" value="path:line-line" />
      <option name="REGEXP" value="$FILE_PATH$:$LINE$" />
    </filter>
  </tool>
  <tool name="Scrutate: callers" showInMainMenu="true" showInEditor="true" showInProject="true" showInSearchPopup="true" disabled="false" useConsole="true" showConsoleOnStdOut="true" showConsoleOnStdErr="true" synchronizeAfterRun="false">
    <exec>
      <option name="COMMAND" value="scrutate" />
      <option name="PARAMETERS" value="callers -- &quot;$SelectedText$&quot;" />
      <option name="WORKING_DIRECTORY" value="$ProjectFileDir$" />
    </exec>
    <filter>
      <option name="NAME" value="file:line" />
      <option name="DESCRIPTION" value="path:line-line" />
      <option name="REGEXP" value="$FILE_PATH$:$LINE$" />
    </filter>
  </tool>
</toolSet>
